# Template only. Store actual values in the staging deployment's secret manager.
AGORA_ENVIRONMENT=staging
AGORA_APP_URL=https://staging.example.invalid
AGORA_PRODUCTION_APP_URL=https://www.example.invalid

# Both Firebase client and Admin SDK must point to the same non-production project.
NEXT_PUBLIC_FIREBASE_API_KEY=REPLACE_WITH_STAGING_FIREBASE_WEB_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=REPLACE_WITH_STAGING_FIREBASE_AUTH_DOMAIN
NEXT_PUBLIC_FIREBASE_PROJECT_ID=REPLACE_WITH_STAGING_FIREBASE_PROJECT_ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=REPLACE_WITH_STAGING_FIREBASE_STORAGE_BUCKET
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=REPLACE_WITH_STAGING_FIREBASE_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=REPLACE_WITH_STAGING_FIREBASE_APP_ID
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
FIREBASE_ADMIN_PROJECT_ID=REPLACE_WITH_STAGING_FIREBASE_PROJECT_ID
AGORA_PRODUCTION_FIREBASE_PROJECT_ID=REPLACE_WITH_PRODUCTION_FIREBASE_PROJECT_ID
# Use staging workload identity or a staging-only server credential via secret management.

# Staging must never use live Paystack keys.
PAYSTACK_MODE=test
PAYSTACK_SECRET_KEY=sk_test_REPLACE_WITH_STAGING_SECRET_KEY
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_REPLACE_WITH_STAGING_PUBLIC_KEY

# Resend and OTP signing secrets must be set in the staging secret manager.
RESEND_API_KEY=REPLACE_WITH_STAGING_RESEND_API_KEY
EMAIL_FROM=Agora <no-reply@your-verified-staging-domain.example>
EMAIL_OTP_HMAC_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
