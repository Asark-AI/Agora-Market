# Client Firebase configuration. Use a non-production project for local development.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Server Firebase Admin credentials. Keep these server-side and out of source control.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

AGORA_ENVIRONMENT=development
# Local development only; production must use the public HTTPS Agora origin.
AGORA_APP_URL=http://localhost:3000
# Optional absolute HTTPS support page URL used in password reset emails.
AGORA_SUPPORT_URL=

PAYSTACK_MODE=test
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Resend email delivery and OTP signing secret (generate at least 32 random bytes).
RESEND_API_KEY=
EMAIL_FROM=Agora <no-reply@your-domain.com>
EMAIL_OTP_HMAC_SECRET=
# Firebase Console / Identity Platform setup:
# - Enable TOTP MFA. The application requires enrollment for Super Admin access;
#   avoid globally enforcing MFA if that would alter buyer/seller sign-in.
# - Set the Password reset email action URL to {AGORA_APP_URL}/reset-password.
# - Set the Admin reset action handler URL to {AGORA_APP_URL}/admin/reset-password.
# - Authorize only the intended production/development app domains.
# - Enable email-enumeration protection and configure a strong password policy.
# Production must set AGORA_APP_URL to the public HTTPS origin; localhost is dev-only.
# Without Resend, Firebase sends the reset email using its Authentication template.
# For the fully branded Agora Admin message, configure RESEND_API_KEY and a
# verified EMAIL_FROM sender domain.

# OAuth callback URLs are derived from AGORA_APP_URL and must be registered
# with each provider as:
#   {AGORA_APP_URL}/api/marketing/oauth/callback/{meta_ads|google_ads|tiktok_ads|google_analytics}
# Keep all provider secrets and the encryption key server-side.
# Generate the key with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
MARKETING_TOKEN_ENCRYPTION_KEY=

META_ADS_CLIENT_ID=
META_ADS_CLIENT_SECRET=
META_GRAPH_API_VERSION=v25.0

GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_API_VERSION=v25
# Optional when requests are made through a Google Ads manager account.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

TIKTOK_ADS_CLIENT_ID=
TIKTOK_ADS_CLIENT_SECRET=

GOOGLE_ANALYTICS_CLIENT_ID=
GOOGLE_ANALYTICS_CLIENT_SECRET=
