# Client Firebase configuration. Use a non-production project for local development.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Server Firebase Admin credentials. Keep these server-side and out of source control.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

AGORA_ENVIRONMENT=development
AGORA_APP_URL=http://localhost:3000

PAYSTACK_MODE=test
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Resend email delivery and OTP signing secret (generate at least 32 random bytes).
RESEND_API_KEY=
EMAIL_FROM=Agora <no-reply@your-domain.com>
EMAIL_OTP_HMAC_SECRET=
